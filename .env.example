# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
# Bind address. Set to 127.0.0.1 when Apache/nginx/Caddy fronts this service,
# so the app is not reachable directly from the internet.
HOST=0.0.0.0
# Public base URL of this service. MUST match the OAuth redirect URIs you
# register with Google / Microsoft. Use https:// in production.
PUBLIC_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Secrets  (generate both with: npm run keygen)
# ---------------------------------------------------------------------------
# 32 random bytes, base64. Encrypts OAuth refresh tokens & IMAP passwords at rest.
# Losing this key means every connected account must be reconnected.
ENCRYPTION_KEY=
# 32+ random bytes, base64. Signs session cookies (JWT).
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Database
# sqlite:  file path (default, zero setup)
# postgres: postgres://user:pass@host:5432/dbname
# ---------------------------------------------------------------------------
DATABASE_URL=sqlite:./data/email-cleaner.sqlite

# ---------------------------------------------------------------------------
# Gmail  -- see docs/providers/gmail.md
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# "modify"    -> trash only (sensitive scope, Tier-2 verification)  [recommended]
# "full"      -> also permanent delete (restricted scope, needs CASA assessment)
GOOGLE_SCOPE_LEVEL=modify

# ---------------------------------------------------------------------------
# Microsoft / Outlook  -- see docs/providers/microsoft.md
# tenant: "common" (work + personal), "consumers" (personal only),
#         "organizations", or a specific tenant GUID
# ---------------------------------------------------------------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# ---------------------------------------------------------------------------
# Yahoo (optional OAuth; app passwords over IMAP work without this)
# -- see docs/providers/yahoo.md
# ---------------------------------------------------------------------------
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Safety rails
# ---------------------------------------------------------------------------
# Refuse to execute a job matching more than this many messages unless the
# request explicitly sets acknowledgeLargeDelete=true.
MAX_DELETE_PER_JOB=25000
# Per-message rows retained for preview + undo. Above this the executor
# re-runs the search instead of replaying stored ids.
MAX_TRACKED_ITEMS=50000
# Days a completed job stays undoable (only meaningful for mode=trash).
UNDO_WINDOW_DAYS=30
# Run the job worker inside the API process. Set false when running
# `npm run start:worker` as a separate process/container.
RUN_WORKER_IN_PROCESS=true
WORKER_CONCURRENCY=2
# Allow self-signed certs on IMAP hosts (dev only).
IMAP_ALLOW_INSECURE_TLS=false
# Allow new user sign-ups. Set false for a private deployment.
# Note: issuing a TLS certificate publishes your hostname to Certificate
# Transparency logs within seconds, so an open sign-up page is discoverable
# immediately. Close registration once your accounts exist.
ALLOW_REGISTRATION=true

# ---------------------------------------------------------------------------
# Brand and legal identity (rendered on the marketing and legal pages, and
# shown to Google/Microsoft reviewers)
# ---------------------------------------------------------------------------
BRAND_NAME=Email Cleaner
LEGAL_ENTITY=
SUPPORT_EMAIL=support@emailcleaner.xyz
PRIVACY_EMAIL=privacy@emailcleaner.xyz
POSTAL_ADDRESS=
LEGAL_JURISDICTION=India

# ---------------------------------------------------------------------------
# Bot protection on the sign-in and registration forms
# provider: 'recaptcha' (Google reCAPTCHA v3), 'turnstile' (Cloudflare), 'none'
# Leave as 'none' and the pages load no third-party script at all.
# ---------------------------------------------------------------------------
CAPTCHA_PROVIDER=none
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET_KEY=
# reCAPTCHA v3 score below which a request is treated as a bot (0.0-1.0).
CAPTCHA_MIN_SCORE=0.5

# ---------------------------------------------------------------------------
# Authentication policy
# ---------------------------------------------------------------------------
# Failed sign-ins per email before a temporary lockout.
MAX_LOGIN_ATTEMPTS=8
LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# false emits a blanket Disallow in robots.txt and noindex on every page.
# Set false on staging so it never competes with production in search.
SEO_INDEXABLE=true
